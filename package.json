{
  "name": "@sothikhorn/cambodia-gazetteer",
  "version": "2.0.0",
  "description": "Cambodia's 25 provinces, 210 districts, 1,652 communes and 14,570 villages with Khmer and English names and NCDD codes. Offline data with TypeScript lookups and search.",
  "keywords": [
    "cambodia",
    "khmer",
    "gazetteer",
    "provinces",
    "districts",
    "communes",
    "villages",
    "administrative-divisions",
    "address",
    "ncdd",
    "cambodia-address",
    "khmer-address",
    "phnom-penh",
    "srok",
    "khum",
    "sangkat",
    "phum",
    "typescript",
    "dataset",
    "offline"
  ],
  "license": "MIT",
  "author": "Sothi Khorn",
  "homepage": "https://github.com/SothiKhorn019/cambodia-gazetteer-js#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SothiKhorn019/cambodia-gazetteer-js.git"
  },
  "bugs": {
    "url": "https://github.com/SothiKhorn019/cambodia-gazetteer-js/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./data/*.json": "./data/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "data",
    "llms.txt"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "sync": "node scripts/sync-data.mjs",
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint:pkg": "publint && attw --pack .",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^24.19.2",
    "publint": "^0.3.25",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
